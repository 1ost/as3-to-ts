{
  "name": "@bleach-tools/as3-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Hardened local-only ActionScript 3 parser frontend.",
  "main": "./lib/command.js",
  "bin": {
    "as3-frontend": "./bin/as3-frontend"
  },
  "files": [
    "bin/as3-frontend",
    "lib/command.js",
    "lib/parser-worker.js",
    "config/authority-lock.json",
    "config/capability-map.json",
    "config/local-type-map.json",
    "src/hardened-cli/THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/typescript/bin/tsc -p tsconfig.cli.json",
    "build:bundle": "esbuild src/command.ts --bundle --platform=node --format=cjs --target=node24 --outfile=lib/command.js --metafile=lib/command.meta.json --legal-comments=eof && esbuild src/hardened-cli/parser-worker.ts --bundle --platform=node --format=cjs --target=node24 --outfile=lib/parser-worker.js --metafile=lib/parser-worker.meta.json --legal-comments=eof",
    "build": "npm run clean && npm run typecheck && npm run build:bundle",
    "test": "npm run build && node --test tests/hardened-cli/*.test.cjs",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "upstream": {
    "name": "@as3web/as3-to-ts",
    "version": "0.3.10",
    "repository": "https://github.com/as3web/as3-to-ts.git",
    "revision": "fa0b5151ab82758511ddd4b464f0c05b80e06da7"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/object-assign": "4.0.33",
    "@types/sax": "1.2.7",
    "esbuild": "0.28.2",
    "object-assign": "4.1.1",
    "sax": "1.6.1",
    "typescript": "7.0.2",
    "typescript-4-9": "npm:typescript@4.9.5"
  }
}
