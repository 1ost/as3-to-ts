 const typeFiles=Object.keys(inputs).map(name=>path.join(dir,name+'.ts'));
 const diagnostics=modern.getPreEmitDiagnostics(modern.createProgram(typeFiles,{noEmit:true,target:modern.ScriptTarget.ES2021,module:modern.ModuleKind.CommonJS,experimentalDecorators:true,strict:false,lib:['lib.es2021.d.ts','lib.dom.d.ts']})).map(d=>({code:d.code,message:modern.flattenDiagnosticMessageText(d.messageText,' ')}));
 fs.writeFileSync(path.join(dir,'diagnostics.json'),JSON.stringify(diagnostics,null,2));assert.deepEqual(diagnostics,[]);
